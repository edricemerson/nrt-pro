# Unused for now - products/admin already talk to Supabase via this app's own
# Route Handlers (src/app/api/*). Only relevant if you stand up a separate
# backend later.
NEXT_PUBLIC_API_URL=

# Supabase project URL and anon key - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - bypasses Row Level Security entirely. Server-side only:
# read by src/lib/supabase.ts (Route Handlers + middleware), NEVER by anything
# marked "use client". Get it from Supabase dashboard > Project Settings > API.
# Put the real value in .env.local, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
